#!/usr/bin/env python3
"""A tiny local todo app for Omarchy/GTK."""

import json
import os
import uuid
from pathlib import Path

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gio, Gdk, Gtk  # noqa: E402

APP_ID = "local.omarchy.Todo"
DATA_DIR = Path.home() / ".local" / "share" / "omarchy-todo"
DATA_FILE = DATA_DIR / "todos.json"


class TodoStore:
    def __init__(self):
        self.todos = []
        self.load()

    def load(self):
        try:
            self.todos = json.loads(DATA_FILE.read_text())
        except FileNotFoundError:
            self.todos = []
        except Exception:
            backup = DATA_FILE.with_suffix(".json.bak")
            try:
                DATA_FILE.rename(backup)
            except Exception:
                pass
            self.todos = []

    def save(self):
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        tmp = DATA_FILE.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(self.todos, indent=2))
        os.replace(tmp, DATA_FILE)

    def add(self, text):
        text = text.strip()
        if not text:
            return
        self.todos.append({"id": uuid.uuid4().hex, "text": text, "done": False})
        self.save()

    def set_done(self, todo_id, done):
        for todo in self.todos:
            if todo["id"] == todo_id:
                todo["done"] = bool(done)
                break
        self.save()

    def delete(self, todo_id):
        self.todos = [todo for todo in self.todos if todo["id"] != todo_id]
        self.save()

    def clear_done(self):
        self.todos = [todo for todo in self.todos if not todo.get("done")]
        self.save()


class TodoApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.store = TodoStore()
        self.listbox = None
        self.empty = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        css = Gtk.CssProvider()
        css.load_from_data(b"""
            window { background: @window_bg_color; }
            .title { font-weight: 700; font-size: 22px; }
            .todo-done { opacity: 0.55; text-decoration-line: line-through; }
            .empty { opacity: 0.65; padding: 24px; }
        """)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def do_activate(self):
        win = Gtk.ApplicationWindow(application=self, title="Todo")
        win.set_default_size(420, 560)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.set_margin_top(16)
        root.set_margin_bottom(16)
        root.set_margin_start(16)
        root.set_margin_end(16)
        win.set_child(root)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        root.append(header)

        title = Gtk.Label(label="Todo")
        title.add_css_class("title")
        title.set_xalign(0)
        title.set_hexpand(True)
        header.append(title)

        clear = Gtk.Button(label="Clear done")
        clear.connect("clicked", self.on_clear_done)
        header.append(clear)

        entry_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        root.append(entry_box)

        self.entry = Gtk.Entry(placeholder_text="Add a task…")
        self.entry.set_hexpand(True)
        self.entry.connect("activate", self.on_add)
        entry_box.append(self.entry)

        add = Gtk.Button(label="Add")
        add.add_css_class("suggested-action")
        add.connect("clicked", self.on_add)
        entry_box.append(add)

        scroller = Gtk.ScrolledWindow()
        scroller.set_vexpand(True)
        root.append(scroller)

        self.stack = Gtk.Stack()
        scroller.set_child(self.stack)

        self.empty = Gtk.Label(label="Nothing to do. Nice.")
        self.empty.add_css_class("empty")
        self.stack.add_named(self.empty, "empty")

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.listbox.add_css_class("boxed-list")
        self.stack.add_named(self.listbox, "list")

        self.refresh()
        win.present()

    def on_add(self, *_):
        self.store.add(self.entry.get_text())
        self.entry.set_text("")
        self.refresh()

    def on_clear_done(self, *_):
        self.store.clear_done()
        self.refresh()

    def refresh(self):
        while row := self.listbox.get_first_child():
            self.listbox.remove(row)

        self.stack.set_visible_child_name("list" if self.store.todos else "empty")

        for todo in self.store.todos:
            self.listbox.append(self.make_row(todo))

    def make_row(self, todo):
        row = Gtk.ListBoxRow()
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        box.set_margin_top(8)
        box.set_margin_bottom(8)
        box.set_margin_start(10)
        box.set_margin_end(10)
        row.set_child(box)

        check = Gtk.CheckButton()
        check.set_active(bool(todo.get("done")))
        check.connect("toggled", self.on_toggle, todo["id"])
        box.append(check)

        label = Gtk.Label(label=todo.get("text", ""), wrap=True)
        label.set_xalign(0)
        label.set_hexpand(True)
        if todo.get("done"):
            label.add_css_class("todo-done")
        box.append(label)

        delete = Gtk.Button(icon_name="user-trash-symbolic")
        delete.set_tooltip_text("Delete")
        delete.connect("clicked", self.on_delete, todo["id"])
        box.append(delete)

        return row

    def on_toggle(self, button, todo_id):
        self.store.set_done(todo_id, button.get_active())
        self.refresh()

    def on_delete(self, _button, todo_id):
        self.store.delete(todo_id)
        self.refresh()


if __name__ == "__main__":
    raise SystemExit(TodoApp().run())
